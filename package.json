{
  "name": "playmaker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types api/src/dev.ts",
    "dev:app": "vite",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json && vite build",
    "test": "vitest run",
    "e2e": "playwright test",
    "content:link": "node scripts/link-content.mjs",
    "fixture": "node scripts/make-fixture.mjs",
    "lab:assets": "node scripts/lab-assets.mjs",
    "cv:render": "node scripts/cv-bench/render.mjs",
    "cv:bench": "node scripts/cv-bench/run.mjs",
    "dev:phone": "vite --host --mode phone",
    "demo:content": "node scripts/demo-content.mjs",
    "demo:build": "node scripts/demo-build.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/three": "0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "ajv": "^8.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.2",
    "three": "0.186.1"
  }
}
